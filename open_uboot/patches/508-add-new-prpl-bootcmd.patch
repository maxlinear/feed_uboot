Index: u-boot-2022.01/cmd/prpl/bootprpl.c
===================================================================
--- /dev/null
+++ u-boot-2022.01/cmd/prpl/bootprpl.c
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) 2026 Mohamed-Nour TOUMI <mohamed.toumi_ext@softathome.com>
+ *
+ */
+#include <common.h>
+#include <command.h>
+
+#include <prpl/prpl_boot.h>
+
+static int do_bootprpl_cmd(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+	(void)cmdtp;
+	(void)flag;
+
+	if (argc > 2)
+		return CMD_RET_USAGE;
+
+	return do_bootprpl(argc, argv);
+}
+
+U_BOOT_CMD(
+	bootprpl, 2, 0, do_bootprpl_cmd,
+	"prpl boot command (retrieve the bank from U-Boot DTB to load the FIT)",
+	"[conf_uname] - configuration specification\n"
+);
Index: u-boot-2022.01/common/prpl/Kconfig
===================================================================
--- u-boot-2022.01.orig/common/prpl/Kconfig
+++ u-boot-2022.01/common/prpl/Kconfig
@@ -3,6 +3,7 @@ menu "prpl"
 config PRPL_BOOT
        bool "prpl boot"
        select OF_SYSTEM_SETUP
+       select FIT
        default n
        help
          Enable prpl boot related feature
@@ -21,6 +22,21 @@ config PRPL_BOOT_MMC_DEVICE
 	help
 	  Define the number of the interface. For example 0 for the first device.
 
+config PRPL_BOOT_USE_EXT4LOAD
+	bool "bootprpl: load FIT from ext4 partition"
+	default n
+	depends on PRPL_BOOT && MMC
+	help
+	  If enabled, the 'bootprpl' command will load the FIT image using:
+	      ext4load mmc 0#<kernel_gpt> <loadaddr> /kernel.itb
+
+	  from the selected bank (kernel-active / kernel-inactive).
+	  If disabled, bootprpl assumes the FIT image is already present
+	  in RAW storage
+	  and will directly execute:
+
+	      bootm ${loadaddr}#kernel-dtb-config
+
 source "cmd/prpl/Kconfig"
 source "lib/prpl/Kconfig"
 endmenu
