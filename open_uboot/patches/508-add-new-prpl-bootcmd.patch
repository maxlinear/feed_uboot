+
+#define BOOTARGS_EXTRA_LEN 64
 
 /**
  * set_root_bootargs() - Set bank information in the bootargs
  *
- * @is_active_bank:	Set 1 when the active bank is booted
+ * @bank:	Set to 0 for the active bank and 1 for inactive bank
