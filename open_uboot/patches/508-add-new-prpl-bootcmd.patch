-static int set_root_bootargs(int is_active_bank)
+static int set_root_bootargs(int bank)
 {
 	int ret = 0;
 	char *bootargs = NULL;
@@ -28,13 +45,18 @@ static int set_root_bootargs(int is_acti
 	char *root = NULL;
 	int len;
 
