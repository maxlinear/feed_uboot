@@ -7,6 +7,7 @@
 #include <string.h>
 #include <command.h>
 #include <fdt_support.h>
+#include <image.h>
 #include <asm/io.h>
 #include <asm/arch/nrst.h>
 #include <asm/global_data.h>
@@ -63,25 +64,15 @@ static ulong get_fdt_loadaddr(void)
 
 #ifdef CONFIG_MXL_SPL_FIT
 	/* For FIT images, need to get the actual FDT load address from the FIT */
-	const void *fdt;
-	int node_offset, len;
-	const char *prop;
-
-	fdt = (void *)dtb_loadaddr;
-	node_offset = fdt_path_offset(fdt, "/images/fdt");
