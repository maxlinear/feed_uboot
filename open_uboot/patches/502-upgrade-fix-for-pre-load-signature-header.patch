+/* Check if image has pre-load signature header (magic "UBSH").
+ * Returns the pre-load header size if present, 0 otherwise.
+ */
+static uint32_t get_preload_size(const void *addr)
+{
+	const struct sig_header_s *hdr = (const struct sig_header_s *)addr;
+
+	if (fdt32_to_cpu(hdr->magic) == IMAGE_PRE_LOAD_SIG_MAGIC)
+		return fdt32_to_cpu(hdr->header_size);
+
+	return 0;
+}
