diff --git a/boot/image-fit.c b/boot/image-fit.c
--- a/boot/image-fit.c
+++ b/boot/image-fit.c
@@ -1958,6 +1958,30 @@ int fit_get_node_from_config(bootm_heade
 	return noffset;
 }
 
+static bool fit_required_conf_sigs_present(const void *sig_blob)
+{
+	int sig_node;
+	int noffset;
+
+	if (!sig_blob)
+		return false;
+
+	sig_node = fdt_subnode_offset(sig_blob, 0, FIT_SIG_NODENAME);
+	if (sig_node < 0)
+		return false;
+
+	fdt_for_each_subnode(noffset, sig_blob, sig_node) {
+		const char *required;
+
+		required = fdt_getprop(sig_blob, noffset, FIT_KEY_REQUIRED,
+				       NULL);
+		if (required && !strcmp(required, "conf"))
+			return true;
+	}
+
+	return false;
+}
+
 /**
  * fit_get_image_type_property() - get property name for IH_TYPE_...
  *
@@ -2030,6 +2054,14 @@ int fit_image_load(bootm_headers_t *imag
 	}
 	bootstage_mark(bootstage_id + BOOTSTAGE_SUB_FORMAT_OK);
 	if (fit_uname) {
+		if (FIT_IMAGE_ENABLE_VERIFY && images->verify &&
+		    !fit_uname_config && !images->fit_uname_cfg &&
+		    fit_required_conf_sigs_present(gd_fdt_blob())) {
+			puts("Signed FIT requires configuration selection; use '#<conf>'\n");
+			bootstage_error(bootstage_id + BOOTSTAGE_SUB_HASH);
+			return -EPERM;
+		}
+
 		/* get FIT component image node offset */
 		bootstage_mark(bootstage_id + BOOTSTAGE_SUB_UNIT_NAME);
 		noffset = fit_image_get_node(fit, fit_uname);
