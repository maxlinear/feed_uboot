+menu "prpl"
+
+config PRPL_BOOT
+       bool "prpl boot"
+       select OF_SYSTEM_SETUP
+       select FIT
+       default n
+       help
+         Enable prpl boot related feature
+
+config PRPL_BOOT_MMC_IFNAME
+	string "interface name"
+	depends on PRPL_BOOT && MMC
+	default "mmc"
+	help
+	  Define the name of mmc interface
+
+config PRPL_BOOT_MMC_DEVICE
+	int "device number"
+	depends on PRPL_BOOT && MMC
+	default 0
+	help
+	  Define the number of the interface. For example 0 for the first device.
+
