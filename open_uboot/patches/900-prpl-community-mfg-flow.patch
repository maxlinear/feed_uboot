diff --git a/cmd/prpl/readmfg.c b/cmd/prpl/readmfg.c
new file mode 100644
--- /dev/null
+++ b/cmd/prpl/readmfg.c
@@ -0,0 +1,136 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) 2025 Yan Wang <yan.wang@softathome.com>
+ */
+
+#include <command.h>
+#include <getopt.h>
+#include <prpl/mfg.h>
+#include <stdio.h>
+
+/**
+ * print_by_name() - Print a specific MFG field by name
+ * @name: Name of the MFG field to print
+ *
+ * Searches for a manufacturing data field by name and prints its value.
+ * Prints an error message if the specified field is not found.
+ * If the field is of type string, the value is printed as a string.
+ * Otherwise, it is printed as hexadecimal bytes.
+ * Decrypting encrypted fields are currently not supported in U-Boot.
+ *
+ * Return: 0 on success, -1 on error
+ */
+static int print_by_name(const char *name)
+{
+	const mfg_entry_t *entry;
+
+	entry = prpl_mfg_get_entry_by_name(name);
+
+	if (NULL == entry) {
+		printf("Entry '%s' not found\n", name);
+		return -1;
+	}
+
+	if (entry->flags & FLAG_STRING) {
+		printf("%s: %s\n", entry->name, (const char *)entry->data);
+	} else {
+		printf("%s: ", entry->name);
+		for (int i = 0; i < entry->length; i++)
+			printf("%02x ", ((const u8 *)entry->data)[i]);
+		printf("\n");
+	}
+
+	return 0;
+}
+
+/**
+ * list_all_field_name() - List all MFG field names
+ *
+ * Iterates through the MFG linked list and prints all entries' name.
+ * This provides a list of all available manufacturing data fields.
+ *
+ * Return: 0 on success
+ */
+static int list_all_field_name(void)
+{
+	const mfg_entry_t *entry;
+
+	printf("All available MFG fields:\n");
+	list_for_each_entry(entry, &mfg_list, node) {
+		printf("%s \n", entry->name);
+	}
+
+	return 0;
+}
+
+/**
+ * do_readmfg() - U-Boot command handler for reading MFG data
+ * @cmdtp: Command table entry (unused)
+ * @flag: Command flags (unused)
+ * @argc: Number of arguments
+ * @argv: Array of argument strings
+ *
+ * Implements the 'readmfg' U-Boot command for reading and displaying
+ * manufacturing data stored in a device tree blob partition.
+ *
+ * Supported options:
+ * -l: List all available MFG field names
+ * -s <name>: Query and print a specific MFG field by name
+ *
+ * The partition name is configured via CONFIG_PRPL_MFG_PART_NAME.
+ *
+ * Return: CMD_RET_SUCCESS on success, CMD_RET_USAGE on invalid arguments,
+ *         or CMD_RET_FAILURE on errors
+ */
+static int do_readmfg(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+	struct getopt_state gs;
+	int opt;
+	int list_all = 0;
+	const char *field_name = NULL;
+	int ret = 0;
+
+	if (argc < 2) {
+		return CMD_RET_USAGE;
+	}
+
+	/* Initialize getopt state */
+	getopt_init_state(&gs);
+	while ((opt = getopt(&gs, argc, argv, "ls:")) > 0) {
+		switch (opt) {
+			case 'l':
+				list_all = 1;
+				break;
+			case 's':
+				field_name = gs.arg;
+				break;
+			default:
+				return CMD_RET_USAGE;
+		}
+	}
+
+	/* Check that all arguments were comsumed */
+	if (gs.index < argc) {
+		printf("Unexpected argument: %s\n", argv[gs.index]);
+		return CMD_RET_USAGE;
+	}
+
+	if (prpl_mfg_init()) {
+		printf("%s: Failed to read the MFG DTB\n", __func__);
+		return CMD_RET_FAILURE;
+	}
+
+	if (list_all) {
+		ret = list_all_field_name();
+	} else {
+		ret = print_by_name(field_name);
+	}
+
+	return ret ? CMD_RET_FAILURE : CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(
+    readmfg, 3, 0, do_readmfg,
+    "Read and print MFG data from a named partition mfgdata",
+    "[-l] [-s name] - list all field's name or query a specific field"
+);
