diff --git a/lib/prpl/mfg.c b/lib/prpl/mfg.c
new file mode 100644
--- /dev/null
+++ b/lib/prpl/mfg.c
@@ -0,0 +1,402 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) 2025 Paul HENRYS <paul.henrys_ext@softathome.com>
+ */
+
+//#define DEBUG
+#include <fdtdec.h>
+#include <ubi_uboot.h>
+#include <image.h>
+#include <uboot_aes.h>
+#include <mapmem.h>
+#include <prpl/mfg.h>
+#include <prpl/prpl_boot_mmc.h>
+
+#define MFG_FDT_NODE_NAME		"MFG_DATA"
+#define MFG_FDT_PROP_ID			"id"		/* Unique ID */
+#define MFG_FDT_PROP_VALUE		"value"		/* value of the field */
+#define MFG_FDT_PROP_TYPE		"type"		/* type of the field (string, raw...) */
+#define MFG_FDT_PROP_SECURE		"secure"	/* means both encrypted and signed (deprecated) */
+#define MFG_FDT_PROP_IS_ENCRYPTED	"is_encrypted"	/* field is encrypted (deprecated) */
+#define MFG_FDT_PROP_IS_SIGNED		"is_signed"	/* field is part of the signature (deprecated)*/
+
+#define MFG_FDT_CIPHER_NODE_NAME	"cipher"	/* Sub-node containing the cipher information */
+#define MFG_FDT_PROP_CIPHER_KEY_NAME	"key_name"	/* Property containing the key name */
+#define MFG_FDT_PROP_CIPHER_FORMAT	"format"	/* Property containing the format of the ciphered data */
+
+#define MFG_FDT_SIG_NODE_NAME		"signature"	/* Sub-node containing the signature information */
+#define MFG_FDT_PROP_SIG_INDEX		"index"		/* Index of the MFG field containing the signature */
+
+#define MFG_GLOBAL_SIG_PATH		"/mfg/sig"
+
+#define ARRAY_SIZE(x) (sizeof(x) / sizeof((x)[0]))
+
+LIST_HEAD(mfg_list);
+
+static int sig_checked = 0;		/* Set to 1 if the signature was checked successfully */
+
+/**
+ * get_entry_by_name() - Find an entry in the mfg list using its name.
+ *
+ * @name:	Name of the mfg field
+ *
+ * @return a pointer to the mfg_entry on success or NULL otherwise.
+ */
+static mfg_entry_t *get_entry_by_name(const char *name)
+{
+	mfg_entry_t *mfg_iter, *mfg_entry = NULL;
+
+	if (!name)
+		goto out;
+
+	list_for_each_entry(mfg_iter, &mfg_list, node) {
+		if (mfg_iter->name && !strcmp(name, mfg_iter->name)) {
+			debug("%s: mfg entry with name %s found (%p)\n", __func__,
+			      mfg_iter->name, mfg_iter);
+			mfg_entry = mfg_iter;
+			if (mfg_entry->secure || mfg_entry->is_encrypted) {
+				debug("Data are encrypted\n");
+			}
+			break;
+		}
+	}
+ out:
+	return mfg_entry;
+}
+
+/**
+ * prpl_mfg_find_dtb() - Load and validate MFG device tree blob
+ * @mfg_part_name: Name of the partition containing the MFG data
+ *
+ * Loads the manufacturing data from the specified partition, optionally
+ * verifies its global signature if CONFIG_PRPL_MFG_GLOBAL_SIG_CHECK is enabled,
+ * and validates the device tree magic number. The function allocates memory
+ * for the DTB and returns a pointer to it.
+ *
+ * When signature verification is enabled:
+ * 1. Reads the partition data
+ * 2. Verifies the global signature using image_pre_load()
+ * 3. Strips the signature header by moving data to remove image_load_offset
+ * 4. Validates the FDT magic number
+ * 5. Reallocates to exact DTB size
+ *
+ * Return: Pointer to the loaded and validated DTB, or NULL on error
+ */
+static void *prpl_mfg_find_dtb(const char *mfg_part_name)
+{
+	int ret = 0;
+	void *mfg_data = NULL;
+	long long mfg_size = 0;
+
+	if (!mfg_part_name) {
+		printf("%s: empty mfg_part_name\n", __func__);
+		goto out;
+	}
+
+	mfg_size = get_data_size(mfg_part_name);
+	if (!mfg_size) {
+		printf("%s: can't get size of mfg volume\n", __func__);
+		goto out;
+	}
+	mfg_data = malloc(mfg_size);
+	if (!mfg_data) {
+		printf("%s: malloc failed\n", __func__);
+		goto out;
+	}
+	if (board_read_firmware(mfg_part_name, mfg_data) < 0) {
+		log_err("ERROR: unable to read data from flash\n");
+		free(mfg_data);
+		goto out;
+	}
+	if (IS_ENABLED(CONFIG_PRPL_MFG_GLOBAL_SIG_CHECK)) {
+		env_set("pre_load_sig_info_path", MFG_GLOBAL_SIG_PATH);
+		ret = image_pre_load((ulong)mfg_data);
+		env_set("pre_load_sig_info_path", NULL);
+		if (ret) {
+			log_err("ERROR: Failed to verify global header signature of mfg data\n");
+			free(mfg_data);
+			env_set("pre_load_sig_info_path", NULL);
+			goto out;
+		}
+		if (fdt_magic(mfg_data + image_load_offset) != FDT_MAGIC) {
+			log_err("ERROR: Failed to retrieve the mfg data from flash\n");
+			free(mfg_data);
+			goto out;
+		}
+		memmove(mfg_data, mfg_data + image_load_offset, fdt_totalsize(mfg_data + image_load_offset));
+	} else {
+		if (fdt_magic(mfg_data) != FDT_MAGIC) {
+			log_err("ERROR: Failed to retrieve the mfg data from flash\n");
+			free(mfg_data);
+			goto out;
+		}
+	}
+	mfg_data = realloc(mfg_data, fdt_totalsize(mfg_data));
+ out:
+	return mfg_data;
+}
+
+/**
+ * parse_dtb() - Parse the mfg DTB
+ *
+ * @return 0 on success or <0 otherwise.
+ */
+static int parse_dtb(void)
+{
+	int ret = 0;
+	void *mfg_fdt = NULL;
+	int mfg_data_offset, node_offset;
+	mfg_entry_t *mfg_entry;
+	const void *node_prop;
+	const void *node_name;
+	int node_len, len;
+
+	mfg_fdt = prpl_mfg_find_dtb(CONFIG_PRPL_MFG_PART_NAME);
+	if (!mfg_fdt) {
+		printf("%s: Failed to read the MFG DTB\n", __func__);
+		ret = -1;
+		goto out;
+	}
+
+	mfg_data_offset = fdt_subnode_offset(mfg_fdt, 0, MFG_FDT_NODE_NAME);
+	if (mfg_data_offset < 0) {
+		printf("%s: %s not found in mfg device tree (%d)\n", __func__,
+		       MFG_FDT_NODE_NAME, mfg_data_offset);
+		ret = mfg_data_offset;
+		goto out;
+	}
+	debug("%s: %s node found in DTB at 0x%x\n", __func__, MFG_FDT_NODE_NAME, mfg_data_offset);
+
+	node_offset = fdt_first_subnode(mfg_fdt, mfg_data_offset);
+	if (node_offset < 0) {
+		printf("%s: No subnode found in %s node\n", __func__, MFG_FDT_NODE_NAME);
+		ret = node_offset;
+		goto out;
+	}
+
+	do {
+		int subnode_offset;
+
+		node_name = fdt_get_name(mfg_fdt, node_offset, &node_len);
+		if (!node_name || node_len < 0) {
+			printf("%s: Could not retrieve the name from node at offset 0x%x (%d)\n",
+			       __func__, node_offset, node_len);
+			continue;
+		}
+		debug("%s: Found sub-node: %s\n", __func__, (const char *)node_name);
+
+		mfg_entry = get_entry_by_name(node_name);
+		if (!mfg_entry) {
+			/* Allocate a new mfg_entry_t and add it to the list */
+			mfg_entry = calloc(1, sizeof(mfg_entry_t));
+			if (!mfg_entry) {
+				printf("%s: calloc failed\n", __func__);
+				/* We probably ran out of memory => stop parsing */
+				ret = errno;
+				goto out;
+			}
+			list_add_tail(&mfg_entry->node, &mfg_list);
+		} else {
+			/* Reuse the entry for update but free all the data pointer */
+			free(mfg_entry->name);
+			free(mfg_entry->cipherkey_name);
+			free(mfg_entry->data);
+			free(mfg_entry->decrypted_data);
+			/* Zero all the structure except the list information */
+			memset(mfg_entry, 0, offsetof(mfg_entry_t, node));
+		}
+
+		node_prop = fdt_getprop(mfg_fdt, node_offset, MFG_FDT_PROP_SECURE, NULL);
+		if (node_prop)
+			mfg_entry->secure = !!be32_to_cpu(*((s32 *)node_prop));
+		else
+			mfg_entry->secure = 0;
+
+		debug("%s: \tSecure: %d\n", __func__, mfg_entry->secure);
+
+		mfg_entry->is_encrypted = 0;
+		mfg_entry->is_signed = 0;
+		node_prop = fdt_getprop(mfg_fdt, node_offset, MFG_FDT_PROP_IS_ENCRYPTED, NULL);
+		if (node_prop)
+			mfg_entry->is_encrypted = !!be32_to_cpu(*((s32 *)node_prop));
+
+		node_prop = fdt_getprop(mfg_fdt, node_offset, MFG_FDT_PROP_IS_SIGNED, NULL);
+		if (node_prop) {
+			mfg_entry->is_signed = !!be32_to_cpu(*((s32 *)node_prop));
+			/* sig_index is not supported in that case => set to -1 */
+			mfg_entry->sig_index = -1;
+		}
+		/* Check if subnodes exist */
+		subnode_offset = fdt_first_subnode(mfg_fdt, node_offset);
+		if (subnode_offset >= 0) {
+			int subnode_len;
+			const void *subnode_name;
+
+			do {
+				subnode_name = fdt_get_name(mfg_fdt, subnode_offset, &subnode_len);
+				if (!subnode_name || subnode_len < 0) {
+					printf("%s: Could not retrieve the name from subnode at offset 0x%x (%d)",
+					       __func__, subnode_offset, subnode_len);
+					continue;
+				}
+				if (!strcmp(subnode_name, MFG_FDT_CIPHER_NODE_NAME)) {
+					mfg_entry->is_encrypted = 1;
+					node_prop = fdt_getprop(mfg_fdt, subnode_offset,
+								MFG_FDT_PROP_CIPHER_KEY_NAME, &len);
+					if (node_prop && len > 0) {
+						mfg_entry->cipherkey_name = malloc(len);
+						if (!mfg_entry->cipherkey_name) {
+							printf("%s: malloc failed\n", __func__);
+							/* We probably run out of memory => stop parsing */
+							ret = errno;
+							goto out;
+						}
+						memcpy(mfg_entry->cipherkey_name, node_prop, len);
+					}
+				} else if (!strcmp(subnode_name, MFG_FDT_SIG_NODE_NAME)) {
+					mfg_entry->is_signed = 1;
+					mfg_entry->sig_index = -1; /* Set sig_index to -1 for now */
+				} else {
+					printf("%s: Unknown subnode %s in node %s at offset 0x%x",
+					       __func__, (const char *)subnode_name,
+					       (const char *)node_name, subnode_offset);
+					continue;
+				}
+			} while (-FDT_ERR_NOTFOUND !=
+				 (subnode_offset = fdt_next_subnode(mfg_fdt, subnode_offset)));
+		}
+
+		debug("%s: \tis_encrypted: %d\n", __func__, mfg_entry->is_encrypted);
+		debug("%s: \tis_signed: %d\n", __func__, mfg_entry->is_signed);
+
+		node_prop = fdt_getprop(mfg_fdt, node_offset, MFG_FDT_PROP_TYPE, &len);
+		if (!node_prop || len < 0) {
+			printf("%s: Could not retrieve type property from node %s", __func__,
+			       (const char *)node_name);
+			continue;
+		}
+		debug("%s: \tType: %s\n", __func__, (const char *)node_prop);
+
+		if (!strncmp(node_prop, "string", len)) {
+			mfg_entry->flags = FLAG_STRING;
+		} else if (!strncmp(node_prop, "raw", len)) {
+			mfg_entry->flags = FLAG_ARRAY;
+		} else {
+			printf("%s: Unsupported type property: %s", __func__,
+			       (const char *)node_prop);
+			continue;
+		}
+
+		node_prop = fdt_getprop(mfg_fdt, node_offset, MFG_FDT_PROP_VALUE, &len);
+		if (!node_prop || len < 0) {
+			printf("%s: Could not retrieve value property from node %s\n", __func__,
+			       (const char *)node_name);
+			continue;
+		}
+		mfg_entry->data = malloc(len);
+		if (!mfg_entry->data) {
+			printf("%s: malloc failed\n", __func__);
+			/* We probably run out of memory => stop parsing */
+			ret = errno;
+			goto out;
+		}
+		memcpy(mfg_entry->data, node_prop, len);
+		mfg_entry->length = (u32)len;
+
+		if (mfg_entry->flags & FLAG_STRING)
+			debug("%s: \tmfg_entry->data=%.*s\n", __func__, len,
+			      (char *)mfg_entry->data);
+		else
+			debug("%s: \tmfg_entry->data=%p\n", __func__, mfg_entry->data);
+
+		debug("%s: \tmfg_entry->length=%d\n", __func__, len);
+
+		mfg_entry->name = malloc(node_len + 1);
+		if (!mfg_entry->name) {
+			printf("%s: malloc failed\n", __func__);
+			/* We probably ran out of memory => stop parsing */
+			ret = errno;
+			goto out;
+		}
+		debug("%s: \tmfg_entry->name=%s\n", __func__, (const char *)node_name);
+		strlcpy(mfg_entry->name, node_name, node_len + 1);
+
+		/* Flag specifically the BASE_MAC_ADDRESS field as a MAC address */
+		if (!strncmp(node_name, "BASE_MAC_ADDRESS", node_len) && mfg_entry->flags == FLAG_ARRAY)
+			mfg_entry->flags |= FLAG_MAC;
+	} while (-FDT_ERR_NOTFOUND != (node_offset = fdt_next_subnode(mfg_fdt, node_offset)));
+
+ out:
+	free(mfg_fdt);
+	return ret;
+}
+
+/**
+ * prpl_mfg_init() - Initialize the mfg list with the MFG DTB stored on the board
+ *
+ * That function should be called at least once to parse the mfg DTB and create
+ * a double linked list containing the mfg fields. Calling multiple times that
+ * function will update the list if any change occurred.
+ *
+ * @return 0 on success or <0 otherwise.
+ */
+int prpl_mfg_init(void)
+{
+	return parse_dtb();
+}
+
+/**
+ * prpl_mfg_get_first_entry() - Return the first mfg entry in list
+ *
+ * @return a pointer on the mfg entry on success or NULL otherwise.
+ */
+const mfg_entry_t *prpl_mfg_get_first_entry(void)
+{
+	return list_entry(&mfg_list, mfg_entry_t, node);
+}
+
+/**
+ * prpl_mfg_get_entry_by_name() - Look for a mfg entry based on its name
+ *
+ * That function returns the entry even if the mfg authenticity is not
+ * successful. It is up to the implementation to first verify the mfg
+ * authenticity status and decide whether the entry should be used or not.
+ *
+ * @name:	The name of the mfg entry to look for
+ *
+ * @return a pointer on the mfg entry on success or NULL otherwise.
+ */
+const mfg_entry_t *prpl_mfg_get_entry_by_name(const char *name)
+{
+	return get_entry_by_name(name);
+}
+
+/**
+ * prpl_mfg_is_signed() - Check if a mfg field is signed
+ *
+ * @mfg_entry:	The mfg_entry to check
+ *
+ * @return 1 if it is signed, 0 if not and <0 otherwise.
+ */
+int prpl_mfg_is_signed(const mfg_entry_t *mfg_entry)
+{
+	if (!mfg_entry)
+		return -1;
+
+	return (mfg_entry->secure || mfg_entry->is_signed);
+}
+
+/**
+ * prpl_mfg_sig_check_passed() - Return the status of the mfg authenticity
+ *
+ * The mfg authenticity is checked everytime prpl_mfg_init() is called. That
+ * function returns the status of the check performed in prpl_mfg_init().
+ * Depending on the returned value, it is up to the implementation to decide
+ * whether to read mfg fields or not.
+ *
+ * @return 1 if authentication passed or 0 otherwise.
+ */
+int prpl_mfg_sig_check_passed(void)
+{
+	return sig_checked;
+}
