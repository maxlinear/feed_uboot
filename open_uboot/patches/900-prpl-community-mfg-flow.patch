diff --git a/include/prpl/mfg.h b/include/prpl/mfg.h
new file mode 100644
--- /dev/null
+++ b/include/prpl/mfg.h
@@ -0,0 +1,106 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) 2025 Paul HENRYS <paul.henrys_ext@softathome.com>
+ */
+#ifndef __PRPL_MFG_H__
+#define __PRPL_MFG_H__
+
+#include <linux/bitops.h>
+#include <linux/list.h>
+#include <linux/types.h>
+
+/** @brief MFG entry contains string data */
+#define FLAG_STRING		BIT(0)
+/** @brief MFG entry contains array data */
+#define FLAG_ARRAY		BIT(1)
+/** @brief MFG entry is read-write */
+#define FLAG_MFG_RW		BIT(2)
+/** @brief MFG entry contains MAC address */
+#define FLAG_MAC		BIT(3)
+
+/**
+ * struct mfg_entry_s - Manufacturing data entry
+ * @name: Name of the MFG field
+ * @secure: Flag indicating if the entry is secure
+ * @is_encrypted: Flag indicating if the entry is encrypted
+ * @is_signed: Flag indicating if the entry is signed
+ * @sig_index: Index of the signature used for this entry
+ * @cipherkey_name: Name of the cipher key used for encryption
+ * @length: Length of the data in bytes
+ * @data: Pointer to the raw (possibly encrypted) data
+ * @decrypted_data_length: Length of the decrypted data in bytes
+ * @decrypted_data: Pointer to the decrypted data
+ * @flags: Combination of FLAG_* bits describing the entry type
+ * @node: List head for linking entries in a doubly-linked list
+ *
+ * This structure represents a single manufacturing data field stored in
+ * the device tree blob. It contains metadata about encryption, signing,
+ * and data format, along with pointers to both encrypted and decrypted data.
+ */
+typedef struct mfg_entry_s {
+	char *name;
+	u8 secure;
+	u8 is_encrypted;
+	u8 is_signed;
+	s8 sig_index;
+	char *cipherkey_name;
+	u32 length;
+	void *data;
+	u32 decrypted_data_length;
+	void *decrypted_data;
+	u32 flags;
+	struct list_head node;
+} mfg_entry_t;
+
+/** @brief List head containing all entries parsed in the MFG */
+extern struct list_head mfg_list;
+
+/**
+ * prpl_mfg_init() - Initialize the mfg list with the mfg DTB stored on the board
+ *
+ * That function should be called at least once to parse the mfg DTB and create
+ * the double linked list containing the mfg fields. Calling several again would
+ * update the list if any change occurred.
+ *
+ * @return 0 on success or <0 otherwise.
+ */
+int prpl_mfg_init(void);
+
+/**
+ * prpl_mfg_get_first_entry() - Return the first mfg entry in list
+ *
+ * @return a pointer on the mfg entry on success or NULL otherwise.
+ */
+const mfg_entry_t *prpl_mfg_get_first_entry(void);
+
+/**
+ * prpl_mfg_get_entry_by_name() - Look for a mfg entry based on its name
+ *
+ * @name:	The name of the mfg entry to look for
+ *
+ * @return a pointer on the mfg entry on success or NULL otherwise.
+ */
+const mfg_entry_t *prpl_mfg_get_entry_by_name(const char *name);
+
+/**
+ * prpl_mfg_is_signed() - Check if a mfg field is signed
+ *
+ * @mfg_entry:	The mfg_entry to check
+ *
+ * @return 1 if it is signed, 0 if not and <0 otherwise.
+ */
+int prpl_mfg_is_signed(const mfg_entry_t *mfg_entry);
+
+/**
+ * prpl_mfg_sig_check_passed() - Return the status of the mfg authenticity
+ *
+ * The MFG authenticity is checked everytime prpl_mfg_init() is called. That
+ * function returns the status of the check performed in prpl_mfg_init().
+ * Depending on the returned value, it is up to the implementation to decide
+ * whether to read MFG fields or not.
+ *
+ * @return 1 if authentication passed or 0 otherwise.
+ */
+int prpl_mfg_sig_check_passed(void);
+
+#endif /* __PRPL_MFG_H__ */
