 		}
@@ -708,7 +711,9 @@ static int chk_udt(void)
 	u32 chk_udt_stat = env_get_ulong("udt_status", 10, 0);
 	u32 chk_boot_cnt = env_get_ulong("boot_count", 10, 0);
 	u32 chk_bootlimit = env_get_ulong("bootlimit", 10, CONFIG_MAX_BOOT_COUNTER);
+	u32 chk_max_boot_cnt = env_get_ulong("max_boot_count", 16, 0);
 	u32 chk_recovery_img = env_get_ulong("recovery_image", 16, 0);
+	u32 boot_reg = readl(BOOT_FAILURE_ADDR);
 
 	/* upgrade request by linux */
 	if ((UDT_UPGRADE_IN_PROGRESS == chk_udt_stat) ||
@@ -737,7 +742,6 @@ static int chk_udt(void)
 			env_changed = 1;
 		}
 	}
-
 	debug("udt_stat: %u | boot_count: %u | bootlimit: %u\n",
 		  chk_udt_stat, chk_boot_cnt, chk_bootlimit);
 
@@ -755,6 +759,17 @@ static void update_spl_boot_status(void)
 	env_set_ulong("image_failure", readl(BOOT_FAILURE_ADDR));
 #else
 	u32 boot_reg;
+	unsigned long failure_status;
+
+	/* Preserve image_failure signaling from SPL via BOOT_FAILURE_ADDR.
+	 * SPL writes RBE_FAILURE or POST_RBE_FAILURE here when falling back
+	 * to the INACTIVE bank (e.g. downgrade rollback scenario). The
+	 * BOOTCOMMAND checks this env var to trigger recover_boot.
+	 * Only set when non-zero to avoid overwriting a valid 0 in normal boot.
+	 */
+	failure_status = readl(BOOT_FAILURE_ADDR);
+	if (failure_status)
+		env_set_ulong("image_failure", failure_status);
 
 	/* Read boot control register from NRST_REG_NRST_2 */
 	boot_reg = readl(NRST_REG_NRST_2);
diff --git a/boot/image-pre-load.c b/boot/image-pre-load.c
index 2965091c2..13875686a 100644
--- a/boot/image-pre-load.c
+++ b/boot/image-pre-load.c
@@ -170,6 +170,18 @@ static int image_pre_load_sig_check_magic(struct image_sig_info *info, ulong add
 
 	if (magic != IMAGE_PRE_LOAD_SIG_MAGIC) {
 		if (info->mandatory) {
+			/* Allow legacy images (uImage IH_MAGIC=0x27051956 or
+			* FIT FDT_MAGIC=0xd00dfeed) to boot without a pre-load
+			* signature even when mandatory is set. This lets a
+			* single u-boot binary support both new signed images
+			* and legacy unsigned images.*/
+			if (magic == IH_MAGIC || magic == 0xd00dfeed) {
+				log_warning("WARNING: pre-load sig mandatory but "
+							"legacy image detected (magic=0x%08x)"
+							", skipping pre-load check\n", magic);
+				ret = 1;
+				goto out;
+			}
 			log_err("ERROR: signature is mandatory\n");
 			ret = -EINVAL;
 			goto out;
