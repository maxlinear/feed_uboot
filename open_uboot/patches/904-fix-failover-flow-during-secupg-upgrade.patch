diff --git a/arch/x86/lib/spl_lgm_image_loader.c b/arch/x86/lib/spl_lgm_image_loader.c
index b27ff5c95..7c4fbf9c7 100644
--- a/arch/x86/lib/spl_lgm_image_loader.c
+++ b/arch/x86/lib/spl_lgm_image_loader.c
@@ -355,6 +355,8 @@ int temporary_failover_boot_sequence(void)
 	int booted_bank = 0;
 	int failover;
 	u32 boot_reg = 0;
+	unsigned long image_failure = 0;
+	ulong udt_status = 0;
 
 	/* Default to terminal unless proven to be a retry-attempt failure. */
 	prpl_terminal_recovery = 1;
@@ -388,6 +390,21 @@ int temporary_failover_boot_sequence(void)
 	debug("RBE Boot Bank: %s (NRST_REG_NRST_2=0x%08x)\n",
 		  (booted_bank == 0) ? "ACTIVE" : "INACTIVE", boot_reg);
 
+	/* If RBE was loaded from INACTIVE bank, the ACTIVE RBE failed.
+	 * Signal failure immediately and fall back to INACTIVE for TEP/U-Boot,
+	 * consistent with the old alt_bank_boot_sequence() behaviour.
+	 * This ensures recovery works correctly during downgrade
+	 * (e.g. 9.2.10 -> 9.1.100) where this SPL (9.2.10) is the backup
+	 * and the new 9.1.100 RBE in ACTIVE failed to load.
+	 */
+	if (booted_bank == 1) {
+		printf("SPL: RBE booted from INACTIVE - ACTIVE RBE failed, signalling failure\n");
+		SET_IMAGE_FAILURE(image_failure, RBE_FAILURE);
+		writel(image_failure, BOOT_FAILURE_ADDR);
+		boot_part = 1;  /* INACTIVE - match TEP/U-Boot to the RBE bank */
+		goto boot_firmware;
+	}
+
 	/* Start WDT (Watchdog Timer) as per flowchart
 	 * Note: Watchdog should already be initialized early in boot,
 	 * this ensures it's running during the boot sequence
@@ -436,6 +453,12 @@ int temporary_failover_boot_sequence(void)
 			} else if (bootcount <= 2 * bootlimit) {
 				boot_part = 1; /* INACTIVE */
 				debug("SPL: BOOT_PART set to INACTIVE (bootcount %d <= 2*bootlimit %d)\n", bootcount, 2 * bootlimit);
+				udt_status = env_get_ulong("udt_status", 10, 0);
+				if (udt_status == 11) {
+					SET_IMAGE_FAILURE(image_failure, POST_RBE_FAILURE);
+					writel(image_failure, BOOT_FAILURE_ADDR);
+					printf("SPL: image_failure set to POST_RBE_FAILURE (0x%lx)\n", image_failure);
+				}
 			} else {
 				printf("SPL: Bootcount %d exceeded 2*bootlimit %d - End of World\n", bootcount, 2 * bootlimit);
 				goto reset;
@@ -460,6 +483,7 @@ int temporary_failover_boot_sequence(void)
 	 */
 	prpl_terminal_recovery = 0;
 
+boot_firmware:
 	/* Load firmware and boot - does not return on success */
 	ret = load_and_boot_firmware(boot_part);
 
